@model Sprint2Activity2.Models.Customer

@{
    ViewData["Title"] = "Detalles Cliente";
}

<h1>Detalles del Cliente</h1>

<div>
    <dl class="row">
        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Apellido</dt>
        <dd class="col-sm-10">@Model.LastName</dd>

        <dt class="col-sm-2">Correo</dt>
        <dd class="col-sm-10">@Model.Email</dd>

        <dt class="col-sm-2">Teléfono</dt>
        <dd class="col-sm-10">@Model.Phone</dd>
    </dl>
</div>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Volver</a>