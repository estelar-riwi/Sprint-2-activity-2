@model Sprint2Activity2.Models.Waiter

@{
    ViewData["Title"] = "Crear Mesero";
}

<h1>Crear Mesero</h1>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div class="form-group">
        <label asp-for="Name">Nombre</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="LastName">Apellido</label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Shift">Turno</label>
        <select asp-for="Shift" class="form-control">
            <option value="">-- Seleccione turno --</option>
            <option value="morning">Mañana</option>
            <option value="afternoon">Tarde</option>
            <option value="night">Noche</option>
        </select>
        <span asp-validation-for="Shift" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Years_Experience">Años de Experiencia</label>
        <input asp-for="Years_Experience" type="number" class="form-control" min="0" />
        <span asp-validation-for="Years_Experience" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</form>