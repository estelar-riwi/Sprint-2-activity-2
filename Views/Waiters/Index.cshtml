@model IEnumerable<Sprint2Activity2.Models.Waiter>

@{
    ViewData["Title"] = "Meseros";
}

<h1>Meseros</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Crear Nuevo Mesero</a>
</p>

<table class="table table-striped">
    <thead>
    <tr>
        <th>Nombre</th>
        <th>Apellido</th>
        <th>Turno</th>
        <th>Años de Experiencia</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model) {
        <tr>
            <td>@item.Name</td>
            <td>@item.LastName</td>
            <td>@item.Shift</td>
            <td>@item.Years_Experience</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Detalles</a> |
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>