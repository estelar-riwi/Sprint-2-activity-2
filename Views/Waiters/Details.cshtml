@model Sprint2Activity2.Models.Waiter

@{
    ViewData["Title"] = "Detalles Mesero";
}

<h1>Detalles del Mesero</h1>

<div>
    <dl class="row">
        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Apellido</dt>
        <dd class="col-sm-10">@Model.LastName</dd>

        <dt class="col-sm-2">Turno</dt>
        <dd class="col-sm-10">@Model.Shift</dd>

        <dt class="col-sm-2">Años de Experiencia</dt>
        <dd class="col-sm-10">@Model.Years_Experience</dd>
    </dl>
</div>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Volver</a>